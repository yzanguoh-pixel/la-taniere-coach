# Copier ce fichier en .env.local et remplir les valeurs (jamais de secret dans le code).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement (scripts de création des comptes de démo). Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_COACH_EMAIL=
DEMO_COACH_PASSWORD=
DEMO_COACHE_EMAIL=
DEMO_COACHE_PASSWORD=
# Aperçu local des écrans sans Supabase (1 = actif). Ne jamais définir sur Vercel.
DEMO_PREVIEW=
